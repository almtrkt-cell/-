# --- WABEL environment variables ---

# Canonical public URL (used for sitemap, robots, canonical tags, OG metadata).
# OPTIONAL — on Vercel it auto-detects your deployment URL (e.g. your-app.vercel.app).
# Set this only to pin a custom domain, e.g. https://wabel.sa once you own it.
# NEXT_PUBLIC_SITE_URL=https://wabel.sa

# Anthropic API key — powers the AI Marketing Audit at /audit.
# Create one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the model used for audits. Default: claude-opus-4-7.
# For a cheaper lead-magnet you can switch to claude-haiku-4-5 or claude-sonnet-4-6.
# ANTHROPIC_MODEL=claude-opus-4-7

# Optional: absolute path for the local leads JSON store (local dev only).
# On Vercel, leads are written to the OS temp dir (ephemeral) — wire a DB/CRM for production.
# LEADS_FILE=
